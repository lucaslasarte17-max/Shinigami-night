name: Preparar juego

on:
  push:
    paths:
      - 'noche-shinigami-vercel.zip'

permissions:
  contents: write

jobs:
  expand:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extraer proyecto
        run: |
          unzip -oq noche-shinigami-vercel.zip -d .
          rm noche-shinigami-vercel.zip

      - name: Guardar archivos
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add noche-shinigami
          git commit -m "Preparar Noche Shinigami"
          git push
